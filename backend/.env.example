# PostgreSQL Database
DATABASE_URL=postgresql://postgres:nic1234@localhost:5432/bhumi_db

# JWT Secret (change this to a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:8000

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# For Railway deployment, DATABASE_URL will be auto-set
